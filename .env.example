# Copy to .env. Everything here is optional for local development.
# The server checks these when it starts and says in plain words what is wrong; see docs/OPERATIONS.md.
# Never commit .env, and never paste a real password or key into a chat, an issue or a screenshot.

# Port of the API server.
PORT=3101

# PostgreSQL connection string (postgres://user:password@host:5432/database).
# Leave empty to use the built-in local database in the folder below.
DATABASE_URL=

# Folder of the built-in database. Used only when DATABASE_URL is empty. One server process at a time.
PGLITE_DIR=data/pg

# Public address of the site, used for the links in patient emails. No path, no trailing slash.
# In production this must be the https address patients open.
PUBLIC_URL=http://localhost:5180

# Set to "production" on a real server: cookies then require https and the start-up checks get stricter.
NODE_ENV=

# 1 (or true) when the server runs behind the host's proxy (most hosting does this); 0, false or empty
# otherwise. It lets the limits on
# logins and bookings see each visitor's own address.
TRUST_PROXY=

# debug, info (default), warn or error.
LOG_LEVEL=

# Email. Leave SMTP_HOST empty to only store emails (they appear in the app's outbox; nothing is sent).
# When SMTP_HOST is set, MAIL_FROM must be a sender your mail provider has verified.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Only for the demo data: allows `npm run seed` against DATABASE_URL or in production. Leave empty.
ALLOW_DEMO_SEED=

# Key for the hashes under which the limits on logins and bookings keep their counters, so that the database
# holds no email or network address there. Optional: when empty it is derived from DATABASE_URL. Set it to a
# long random text if you want it to survive a change of database address.
RATE_LIMIT_SECRET=
